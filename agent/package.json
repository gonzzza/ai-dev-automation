{
  "name": "agent",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-driven feature agent: reads a markdown spec, implements it with tests, opens a PR.",
  "type": "module",
  "bin": {
    "spec-agent": "dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec:check": "tsx src/spec-check.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "zod": "^4.6.7"
  }
}
