{
  "name": "ai-dev-automation",
  "private": true,
  "description": "Spec -> agent writes the code -> PR -> AI review -> human approves",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "standards",
    "demo-app",
    "review-action",
    "spec-coding-agent"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run spec:check",
    "spec:check": "npm run spec:check -w spec-coding-agent",
    "agent": "npm start -w spec-coding-agent --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
